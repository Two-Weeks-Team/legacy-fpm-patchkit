+/* Delayed OOM state. NTS keeps it in a plain global so the VM safe-point check
+ * stays a load; ZTS keeps it in the private allocator globals. Neither touches
+ * a public EG/CG layout. */
+#ifndef ZTS
+ZEND_API zend_oom_info zend_mm_delayed_oom;
+# define ZEND_MM_OOM() (&zend_mm_delayed_oom)
+#else
+# define ZEND_MM_OOM() (zend_get_oom_info())
+#endif
+
+static void zend_mm_current_location(const char **filename, uint32_t *lineno)
+{
+	*filename = NULL;
+	*lineno = 0;
+	if (zend_is_compiling()) {
+		*filename = ZSTR_VAL(zend_get_compiled_filename());
+		*lineno = zend_get_compiled_lineno();
+	} else if (zend_is_executing()) {
+		*filename = zend_get_executed_filename();
+		if ((*filename)[0] == '[') { /* [no active file] */
+			*filename = NULL;
+		} else {
+			*lineno = zend_get_executed_lineno();
+		}
+	}
+	if (*filename == NULL) {
+		*filename = "Unknown";
+		*lineno = 0;
+	}
+}
+
+/* Records the first soft failure; it is reported later from a safe point by
+ * zend_handle_delayed_oom(). Never unwinds from inside the allocator. */
+static ZEND_COLD void zend_mm_delayed_verror(const char *format, va_list args)
+{
+	zend_oom_info *info = ZEND_MM_OOM();
+	const char *filename;
+	uint32_t lineno;
+	char buf[1024];
+
+	if (info->state != ZEND_OOM_STATE_NONE) {
+		return;
+	}
+
+	zend_mm_current_location(&filename, &lineno);
+	vsnprintf(buf, sizeof(buf), format, args);
+
+	/* Persistent copies: independent of the request heap and of op_array lifetime */
+	info->message = zend_string_init(buf, strlen(buf), 1);
+	info->filename = zend_string_init(filename, strlen(filename), 1);
+	info->lineno = lineno;
+	info->state = ZEND_OOM_STATE_PENDING;
+}
+
+static ZEND_COLD void zend_mm_delayed_error(const char *format, ...)
+{
+	va_list args;
+	va_start(args, format);
+	zend_mm_delayed_verror(format, args);
+	va_end(args);
+}
+
+ZEND_API ZEND_COLD void zend_mm_delayed_error_or_panic(zend_bool delay, const char *format, ...)
+{
+	va_list args;
+	va_start(args, format);
+
+	if (delay) {
+		zend_mm_delayed_verror(format, args);
+	} else {
+		char buf[1024];
+		vsnprintf(buf, sizeof(buf), format, args);
+		zend_mm_panic(buf);
+	}
+
+	va_end(args);
+}
+
+ZEND_API ZEND_COLD void zend_mm_oom_info_dtor(zend_oom_info *info)
+{
+	if (info->message) {
+		zend_string_release(info->message);
+		info->message = NULL;
+	}
+	if (info->filename) {
+		zend_string_release(info->filename);
+		info->filename = NULL;
+	}
+}
