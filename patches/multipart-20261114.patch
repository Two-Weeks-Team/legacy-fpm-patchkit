+/* Resolve the default without signed overflow. Negative configured values use
+ * max_input_vars + max_file_uploads, as upstream does. Saturate an overflowing
+ * sum and clamp a negative sum (possible with a negative upload setting) to 0.
+ * The remaining budget is request-local; never decrement the INI global. */
+static zend_long php_rfc1867_body_parts_limit(zend_long configured, zend_long input_vars, zend_long uploads)
+{
+	zend_long limit;
+
+	if (configured >= 0) {
+		return configured;
+	}
+	if (input_vars < 0) {
+		input_vars = 0;
+	}
+	if (uploads > 0 && input_vars > ZEND_LONG_MAX - uploads) {
+		return ZEND_LONG_MAX;
+	}
+	limit = input_vars + uploads;
+	return limit > 0 ? limit : 0;
+}
